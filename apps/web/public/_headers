# Files under /assets carry a hash of their content in the name, so a browser may keep them for good.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Fonts, artwork and icons keep their names between releases. A browser keeps them for a day, then checks back.
/fonts/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
/marketing/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
/journal/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
/design/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
/memory-icons/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
