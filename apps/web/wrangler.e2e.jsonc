{
  "name": "everlittle-e2e",
  "main": "src/server.ts",
  "compatibility_date": "2026-08-06",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "not_found_handling": "single-page-application",
  },
  "secrets": {
    "required": ["BETTER_AUTH_SECRET", "CHILD_PIN_PEPPER"],
  },
  "vars": {
    "APP_NAME": "Everlittle",
    "DEPLOYMENT_MODE": "hosted",
    "PUBLIC_APP_URL": "http://localhost:3000",
    "INVITATION_FROM_EMAIL": "invites@example.com",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "everlittle-e2e",
      "database_id": "local-test-db",
      "migrations_dir": "migrations",
    },
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "everlittle-e2e",
    },
  ],
  "send_email": [
    {
      "name": "EMAIL",
    },
  ],
  "observability": {
    "enabled": true,
    "logs": {
      "head_sampling_rate": 1,
    },
  },
}
