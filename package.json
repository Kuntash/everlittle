{
  "name": "everlittle",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vp run @everlittle/web#dev",
    "build": "vp run @everlittle/web#build",
    "typecheck": "vp run @everlittle/web#typecheck",
    "ready": "pnpm --filter @everlittle/web generate-routes && vp check && vp run @everlittle/web#test && vp run @everlittle/web#build",
    "test": "vp run @everlittle/web#test",
    "cf-typegen": "vp run @everlittle/web#cf-typegen",
    "db:migrate:local": "vp run @everlittle/web#db:migrate:local",
    "db:migrate:remote": "vp run @everlittle/web#db:migrate:remote",
    "db:migrate:self-hosted": "vp run @everlittle/web#db:migrate:self-hosted",
    "db:migrate:hosted": "vp run @everlittle/web#db:migrate:hosted",
    "self-host:check": "vp run @everlittle/web#self-host:check",
    "build:self-hosted": "vp run @everlittle/web#build:self-hosted",
    "deploy:self-hosted": "vp run @everlittle/web#deploy:self-hosted",
    "deploy:hosted": "vp run @everlittle/web#deploy:hosted",
    "setup:hooks": "git config core.hooksPath .githooks",
    "setup:vp": "vp config"
  },
  "devDependencies": {
    "vite-plus": "catalog:"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "pnpm@11.0.9"
}
