{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "everlittle",
  "compatibility_date": "2026-08-05",
  "compatibility_flags": ["nodejs_compat"],
  "main": "src/server.ts",
  "secrets": {
    "required": ["BETTER_AUTH_SECRET", "CHILD_PIN_PEPPER"],
  },
  "assets": {
    "not_found_handling": "single-page-application",
  },
  "observability": {
    "enabled": true,
    "logs": { "head_sampling_rate": 1 },
  },
  "vars": {
    "APP_NAME": "Everlittle",
    "DEPLOYMENT_MODE": "self-hosted",
    "INVITATION_FROM_EMAIL": "invites@example.com",
    "PUBLIC_APP_URL": "http://localhost:3000",
  },
  "send_email": [{ "name": "EMAIL" }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "everlittle-db",
      "database_id": "replace-with-your-d1-database-id",
      "migrations_dir": "migrations",
    },
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "everlittle-media",
    },
  ],
  "env": {
    "hosted": {
      "name": "everlittle-hosted",
      "secrets": {
        "required": ["BETTER_AUTH_SECRET", "CHILD_PIN_PEPPER"],
      },
      "routes": [
        {
          "pattern": "geteverlittle.com",
          "custom_domain": true,
        },
      ],
      "vars": {
        "APP_NAME": "Everlittle",
        "DEPLOYMENT_MODE": "hosted",
        "INVITATION_FROM_EMAIL": "invites@geteverlittle.com",
        "PUBLIC_APP_URL": "https://geteverlittle.com",
      },
      "send_email": [
        {
          "name": "EMAIL",
          "allowed_sender_addresses": ["invites@geteverlittle.com"],
        },
      ],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "everlittle-hosted-db",
          "database_id": "3b114b81-448b-46d1-80fc-5dd9010f447f",
          "migrations_dir": "migrations",
        },
      ],
      "r2_buckets": [
        {
          "binding": "MEDIA",
          "bucket_name": "everlittle-hosted-media",
        },
      ],
    },
  },
}
