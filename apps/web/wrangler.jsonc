{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "everlittle",
  "compatibility_date": "2026-08-05",
  "compatibility_flags": ["nodejs_compat"],
  "main": "src/server.ts",
  "secrets": {
    "required": ["BETTER_AUTH_SECRET"],
  },
  "assets": {
    "not_found_handling": "single-page-application",
  },
  "observability": {
    "enabled": true,
    "logs": { "head_sampling_rate": 1 },
  },
  "vars": {
    "APP_NAME": "Everlittle",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "everlittle-db",
      "database_id": "replace-with-your-d1-database-id",
      "migrations_dir": "migrations",
    },
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "everlittle-media",
    },
  ],
  "env": {
    "production": {
      "name": "everlittle-dikichoetso",
      "secrets": {
        "required": ["BETTER_AUTH_SECRET"],
      },
      "routes": [
        {
          "pattern": "dikichoetso.com",
          "custom_domain": true,
        },
      ],
      "vars": {
        "APP_NAME": "Everlittle",
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "everlittle-dikichoetso-db",
          "database_id": "09349ff2-e49b-4656-a48d-a3b6d9b74437",
          "migrations_dir": "migrations",
        },
      ],
      "r2_buckets": [
        {
          "binding": "MEDIA",
          "bucket_name": "everlittle-dikichoetso-media",
        },
      ],
    },
  },
}
